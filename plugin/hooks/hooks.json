{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/jev-router.js"
            ],
            "timeout": 5,
            "statusMessage": "Jev sizing message..."
          }
        ]
      }
    ],
    "PostModelSwitch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/jev-model-switch.js"
            ],
            "timeout": 5
          }
        ]
      }
    ]
  }
}
